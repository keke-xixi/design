[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/stage_select.gd" id="1_select"]

[node name="StageSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_select")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.1, 0.12, 0.92)

[node name="Panel" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -280.0
offset_top = -150.0
offset_right = 280.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Panel"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "选择关卡"

[node name="BackButton" type="Button" parent="Panel/Header"]
layout_mode = 2
text = "返回广场"

[node name="Hint" type="Label" parent="Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.76, 0.8, 1)
theme_override_font_sizes/font_size = 12
text = "宗门 → 国家 → 星球 → 星系 → 世界 → 宇宙。通关上一关解锁下一关。"

[node name="Scroll" type="ScrollContainer" parent="Panel"]
layout_mode = 2
size_flags_vertical = 3
custom_minimum_size = Vector2(0, 220)

[node name="List" type="VBoxContainer" parent="Panel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[connection signal="pressed" from="Panel/Header/BackButton" to="." method="_on_back_pressed"]
