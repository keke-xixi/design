[connection signal="pressed" from="Panel/Header/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Panel/Slots/Weapon/V/Unequip" to="." method="_on_unequip_weapon"]
[connection signal="pressed" from="Panel/Slots/Armor/V/Unequip" to="." method="_on_unequip_armor"]
