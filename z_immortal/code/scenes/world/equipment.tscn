[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/equipment.gd" id="1_equip"]
[ext_resource type="Texture2D" path="res://assets/backgrounds/select_bg.png" id="2_bg"]

[node name="Equipment" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
