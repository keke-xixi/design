[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/equipment.gd" id="1_equip"]
[ext_resource type="Texture2D" path="res://assets/backgrounds/hub_bg.png" id="2_bg"]
[ext_resource type="Texture2D" path="res://assets/characters/hub_hero.png" id="3_hero"]

[node name="Equipment" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_equip")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_bg")
expand_mode = 1
stretch_mode = 6

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.03, 0.05, 0.08, 0.5)

[node name="Hero" type="TextureRect" parent="."]
layout_mode = 0
offset_left = 8.0
offset_top = 40.0
offset_right = 250.0
offset_bottom = 340.0
mouse_filter = 2
texture = ExtResource("3_hero")
expand_mode = 1
stretch_mode = 5

[node name="Panel" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 248.0
offset_top = 10.0
offset_right = 630.0
offset_bottom = 350.0
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Panel"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.98, 0.93, 0.78, 1)
theme_override_font_sizes/font_size = 20
text = "装备"

[node name="BackButton" type="Button" parent="Panel/Header"]
layout_mode = 2
text = "返回"

[node name="Slots" type="HBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Weapon" type="PanelContainer" parent="Panel/Slots"]
layout_mode = 2
size_flags_horizontal = 3

[node name="V" type="VBoxContainer" parent="Panel/Slots/Weapon"]
layout_mode = 2

[node name="Label" type="Label" parent="Panel/Slots/Weapon/V"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "武"

[node name="Value" type="Label" parent="Panel/Slots/Weapon/V"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "—"

[node name="Unequip" type="Button" parent="Panel/Slots/Weapon/V"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "卸"

[node name="Armor" type="PanelContainer" parent="Panel/Slots"]
layout_mode = 2
size_flags_horizontal = 3

[node name="V" type="VBoxContainer" parent="Panel/Slots/Armor"]
layout_mode = 2

[node name="Label" type="Label" parent="Panel/Slots/Armor/V"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "甲"

[node name="Value" type="Label" parent="Panel/Slots/Armor/V"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "—"

[node name="Unequip" type="Button" parent="Panel/Slots/Armor/V"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "卸"

[node name="Accessory" type="PanelContainer" parent="Panel/Slots"]
layout_mode = 2
size_flags_horizontal = 3

[node name="V" type="VBoxContainer" parent="Panel/Slots/Accessory"]
layout_mode = 2

[node name="Label" type="Label" parent="Panel/Slots/Accessory/V"]
layout_mode = 2
