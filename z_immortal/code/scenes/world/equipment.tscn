[node name="BagScroll" type="ScrollContainer" parent="Panel"]
custom_minimum_size = Vector2(0, 140)
layout_mode = 2
size_flags_vertical = 3

[node name="BagList" type="VBoxContainer" parent="Panel/BagScroll"]
layout_mode = 2
