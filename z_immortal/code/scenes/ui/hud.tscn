[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/hud.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="VBoxContainer" parent="Root"]
layout_mode = 0
offset_left = 10.0
offset_top = 8.0
offset_right = 360.0
offset_bottom = 72.0
theme_override_constants/separation = 1

[node name="RealmLabel" type="Label" parent="Root/Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.86, 0.62, 1)
theme_override_colors/font_shadow_color = Color(0.05, 0.07, 0.05, 0.85)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
theme_override_font_sizes/font_size = 16
text = "境界"

[node name="QiLabel" type="Label" parent="Root/Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.9, 0.82, 1)
theme_override_colors/font_shadow_color = Color(0.05, 0.07, 0.05, 0.85)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
theme_override_font_sizes/font_size = 14
text = "灵气"

[node name="HintLabel" type="Label" parent="Root/Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.74, 0.7, 1)
theme_override_colors/font_shadow_color = Color(0.05, 0.07, 0.05, 0.85)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
theme_override_font_sizes/font_size = 12
text = "WASD 移动    J 吐纳    K 突破"
