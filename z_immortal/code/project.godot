; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="长生"
config/description="A 2D cultivation RPG built for Steam."
config/version="0.1.0"
run/main_scene="res://scenes/world/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
ContentDB="*res://src/data/content_db.gd"
GameState="*res://src/data/game_state.gd"
SteamService="*res://src/steam/steam_service.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[gui]

theme/custom_font="res://assets/fonts/cjk_system.tres"

[internationalization]

locale/fallback="zh_CN"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="npc"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
