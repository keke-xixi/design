; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="通玄之上"
config/description="凡躯登仙路，一剑破通玄。2D 修仙 RPG，Steam 目标平台。"
config/version="0.1.0"
run/main_scene="res://scenes/world/hub.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
ContentDB="*res://src/data/content_db.gd"
GameState="*res://src/data/game_state.gd"
SteamService="*res://src/steam/steam_service.gd"
SceneManager="*res://src/core/scene_manager.gd"
SaveService="*res://src/data/save_service.gd"
FloatTextManager="*res://src/ui/float_text_manager.gd"
LootService="*res://src/core/loot_service.gd"
MarketService="*res://src/data/market_service.gd"
AlchemyService="*res://src/data/alchemy_service.gd"
SfxService="*res://src/core/sfx_service.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[gui]

theme/custom_font="res://assets/fonts/cjk_system.tres"

[internationalization]

locale/fallback="zh_CN"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="npc"
2d_physics/layer_4="enemy"
2d_physics/layer_5="projectile"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
