page {
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #FF6B35;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.price {
  color: #FF6B35;
  font-weight: bold;
}

.price-symbol {
  font-size: 24rpx;
}

.price-int {
  font-size: 36rpx;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #FF6B35;
  border: 1rpx solid #FF6B35;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
