<view wx:if="{{product}}" class="page">
  <view class="hero">
    <text class="hero-emoji">🥘</text>
    <view class="hero-badge">净菜配齐 · 免洗免切</view>
  </view>

  <view class="card info-card">
    <view class="name">{{product.name}}</view>
    <view class="sub">{{product.subtitle}}</view>
    <view class="tags">
      <text class="tag">{{product.servings}}人份</text>
      <text class="tag">约{{product.cook_time}}分钟</text>
      <text class="tag">已售{{product.sales}}</text>
    </view>
    <view class="price-row">
      <text class="price">¥{{product.price}}</text>
      <text wx:if="{{product.original_price}}" class="original">¥{{product.original_price}}</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">食材清单（已洗已切）</view>
    <view class="ingredient" wx:for="{{product.ingredients}}" wx:key="*this">· {{item}}</view>
  </view>

  <view class="card">
    <view class="section-title">烹饪步骤</view>
    <view class="step" wx:for="{{product.steps}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="footer">
    <view class="qty">
      <view class="qty-btn" bindtap="changeQty" data-type="minus">-</view>
      <text>{{quantity}}</text>
      <view class="qty-btn" bindtap="changeQty" data-type="plus">+</view>
    </view>
    <button class="btn-cart" bindtap="addToCart">加入购物车</button>
    <button class="btn-buy" bindtap="buyNow">立即下单</button>
  </view>
</view>
