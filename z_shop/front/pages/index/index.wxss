.page {
  padding-bottom: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 0 28rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.45;
}

.search-placeholder {
  font-size: 26rpx;
  color: #bbb;
}

.section {
  padding: 24rpx 24rpx 0;
}

.category-section {
  padding-top: 16rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

.section-tip {
  font-size: 22rpx;
  color: #FF6B35;
  background: #FFF3EE;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.category-grid {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.category-scroll {
  white-space: nowrap;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 130rpx;
  margin-right: 20rpx;
}

.category-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.cat-bg-0 { background: linear-gradient(135deg, #FFF0E8, #FFE4D6); }
.cat-bg-1 { background: linear-gradient(135deg, #FFEBEE, #FFCDD2); }
.cat-bg-2 { background: linear-gradient(135deg, #E8F5E9, #C8E6C9); }
.cat-bg-3 { background: linear-gradient(135deg, #E3F2FD, #BBDEFB); }
.cat-bg-4 { background: linear-gradient(135deg, #FFF8E1, #FFECB3); }

.category-icon {
  font-size: 44rpx;
}

.category-name {
  font-size: 24rpx;
  color: #555;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.product-img-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  background: #f5f5f5;
}

.product-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.hot-badge {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #FF6B35, #FF8F65);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx 0 16rpx 0;
  z-index: 1;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-height: 200rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.3;
}

.product-sub {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0 12rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: auto;
}

.meta-tag {
  font-size: 20rpx;
  color: #FF6B35;
  background: #FFF3EE;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.meta-tag.sales {
  color: #999;
  background: #F5F5F5;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.original {
  font-size: 22rpx;
  color: #ccc;
  text-decoration: line-through;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F65);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.35);
}

.add-icon {
  color: #fff;
  font-size: 40rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.loading {
  text-align: center;
  color: #999;
  padding: 60rpx;
}
