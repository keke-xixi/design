.page { padding: 24rpx; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

input, textarea {
  font-size: 28rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
}

textarea { min-height: 120rpx; border-bottom: none; }

.save-btn { margin-top: 32rpx; }
