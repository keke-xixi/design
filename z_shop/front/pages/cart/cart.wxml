<view wx:if="{{cart.length}}" class="page">
  <view class="item" wx:for="{{cart}}" wx:key="product_id">
    <image class="item-img" src="{{item.image}}" mode="aspectFill" />
    <view class="item-info">
      <view class="name">{{item.name}}</view>
      <view class="price">¥{{item.price}}</view>
      <view class="actions">
        <view class="qty">
          <view class="qty-btn" bindtap="changeQty" data-id="{{item.product_id}}" data-type="minus">-</view>
          <text>{{item.quantity}}</text>
          <view class="qty-btn" bindtap="changeQty" data-id="{{item.product_id}}" data-type="plus">+</view>
        </view>
        <text class="remove" bindtap="removeItem" data-id="{{item.product_id}}">删除</text>
      </view>
    </view>
  </view>

  <view class="summary card">
    <view class="row"><text>商品合计</text><text>¥{{totalPrice}}</text></view>
    <view class="row"><text>配送费</text><text>{{deliveryFee > 0 ? '¥' + deliveryFee : '免配送费'}}</text></view>
    <view class="row total"><text>应付</text><text class="price">¥{{payAmount}}</text></view>
    <view wx:if="{{totalPrice > 0 && totalPrice < 39}}" class="tip">满39元免配送费，还差 ¥{{39 - totalPrice}}</view>
  </view>

  <view class="footer">
    <view class="total-text">合计 <text class="price">¥{{payAmount}}</text></view>
    <button class="btn-primary checkout-btn" bindtap="checkout">去结算</button>
  </view>
</view>

<view wx:else class="empty">
  <view class="empty-icon">🛒</view>
  <view>购物车是空的</view>
  <button class="btn-primary go-shop" bindtap="goShop">去逛逛</button>
</view>
