.page { padding: 24rpx; padding-bottom: 160rpx; }

.item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-info { flex: 1; margin-left: 20rpx; }
.name { font-size: 28rpx; font-weight: bold; }
.price { color: #FF6B35; margin: 8rpx 0; }

.actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.qty { display: flex; align-items: center; gap: 16rpx; }
.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  text-align: center;
  line-height: 48rpx;
}

.remove { color: #999; font-size: 24rpx; }

.summary { margin-top: 20rpx; }
.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #666;
}

.row.total { font-size: 30rpx; color: #333; font-weight: bold; border-top: 1rpx solid #eee; margin-top: 8rpx; padding-top: 16rpx; }
.tip { font-size: 22rpx; color: #FF6B35; margin-top: 8rpx; }

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.checkout-btn { width: 240rpx; margin: 0; }

.go-shop { margin-top: 32rpx; width: 300rpx; }
