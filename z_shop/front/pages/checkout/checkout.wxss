.page { padding: 24rpx; padding-bottom: 160rpx; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-weight: bold;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

input {
  border-bottom: 1rpx solid #eee;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #666;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #666;
}

.row.total {
  border-top: 1rpx solid #eee;
  margin-top: 8rpx;
  padding-top: 16rpx;
  font-weight: bold;
  color: #333;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.submit-btn { width: 280rpx; margin: 0; }

.address-card { min-height: 120rpx; }

.address-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.empty-text { color: #FF6B35; font-size: 30rpx; font-weight: 600; }

.addr-line {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.name { font-weight: 700; font-size: 30rpx; }
.phone { color: #666; }
.addr-detail { color: #666; font-size: 26rpx; line-height: 1.5; margin-bottom: 12rpx; }
.change-link { color: #FF6B35; font-size: 26rpx; }
