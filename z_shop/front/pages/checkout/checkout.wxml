<view class="page">
  <view class="card">
    <view class="card-title">🛵 配送地址</view>
    <input placeholder="收货人姓名" value="{{address.name}}" data-field="name" bindinput="onInput" />
    <input placeholder="手机号" type="number" value="{{address.phone}}" data-field="phone" bindinput="onInput" />
    <input placeholder="详细地址（小区/楼栋/门牌号）" value="{{address.detail}}" data-field="detail" bindinput="onInput" />
  </view>

  <view class="card">
    <view class="card-title">商品清单</view>
    <view class="item" wx:for="{{cart}}" wx:key="product_id">
      <text>{{item.name}} x{{item.quantity}}</text>
      <text>¥{{item.price * item.quantity}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">备注</view>
    <input placeholder="如有特殊要求请备注" value="{{remark}}" bindinput="onRemark" />
  </view>

  <view class="card summary">
    <view class="row"><text>商品合计</text><text>¥{{totalPrice}}</text></view>
    <view class="row"><text>配送费</text><text>{{deliveryFee ? '¥' + deliveryFee : '免配送费'}}</text></view>
    <view class="row total"><text>应付</text><text class="price">¥{{payAmount}}</text></view>
  </view>

  <view class="footer">
    <view>合计 <text class="price">¥{{payAmount}}</text></view>
    <button class="btn-primary submit-btn" bindtap="submitOrder" loading="{{submitting}}">提交订单</button>
  </view>
</view>
