.search-header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 16rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-btn {
  color: #ccc;
  font-size: 28rpx;
  padding: 8rpx;
}

.search-btn {
  color: #FF6B35;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

.hot-section {
  padding: 32rpx 24rpx;
}

.hot-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-tag {
  background: #fff;
  color: #555;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
}

.result-section {
  padding: 0 24rpx 24rpx;
}

.result-count {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 0;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.product-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-height: 200rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.product-sub {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0 12rpx;
}

.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: auto;
}

.meta-tag {
  font-size: 20rpx;
  color: #FF6B35;
  background: #FFF3EE;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.price {
  color: #FF6B35;
  font-weight: bold;
}

.price-symbol { font-size: 24rpx; }
.price-int { font-size: 36rpx; }

.original {
  font-size: 22rpx;
  color: #ccc;
  text-decoration: line-through;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F65);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.35);
}

.add-icon {
  color: #fff;
  font-size: 40rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.loading, .empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
