.header-card {
  background: linear-gradient(135deg, #FF6B35, #FF8F65);
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  color: #fff;
}

.label { font-size: 26rpx; opacity: 0.85; }
.total { font-size: 56rpx; font-weight: 700; margin: 8rpx 0 24rpx; }

.sub-stats { display: flex; border-top: 1rpx solid rgba(255,255,255,0.25); padding-top: 24rpx; }
.sub-stat { flex: 1; text-align: center; }
.num { display: block; font-size: 32rpx; font-weight: 700; }
.lbl { font-size: 22rpx; opacity: 0.85; }

.section-title {
  padding: 0 24rpx 16rpx;
  font-weight: 700;
  font-size: 28rpx;
}

.list { padding: 0 24rpx; }

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}

.item-title { font-weight: 600; font-size: 28rpx; }
.item-time { color: #999; font-size: 24rpx; margin-top: 4rpx; }
.item-amount { color: #FF6B35; font-weight: 700; font-size: 32rpx; }

.loading, .empty { text-align: center; padding: 80rpx; color: #999; }
