.store-bar {
  display: flex;
  align-items: center;
  background: #FFF3EE;
  padding: 20rpx 24rpx;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
}

.store-icon { font-size: 40rpx; margin-right: 16rpx; }
.store-info { flex: 1; }
.store-name { font-weight: 600; font-size: 28rpx; }
.store-addr { font-size: 24rpx; color: #666; margin-top: 4rpx; }
.store-nav { color: #FF6B35; font-size: 26rpx; }

.list { padding: 0 24rpx 24rpx; }

.order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.order-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no { font-weight: 700; }
.item-count { color: #999; font-size: 24rpx; }

.pick-list, .deliver-info {
  margin-bottom: 16rpx;
}

.pick-title, .deliver-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.pick-item {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #444;
  padding: 6rpx 0;
}

.pick-qty { color: #FF6B35; font-weight: 600; }

.deliver-name { font-size: 28rpx; font-weight: 600; }
.deliver-addr { font-size: 26rpx; color: #666; margin-top: 4rpx; }

.order-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.fee { color: #FF6B35; font-weight: 600; }

.accept-btn {
  background: #FF6B35;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 40rpx;
  margin: 0;
  line-height: 72rpx;
}

.accept-btn::after { border: none; }

.loading, .empty { text-align: center; padding: 120rpx 0; color: #999; }
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
