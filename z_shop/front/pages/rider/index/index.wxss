.login-page {
  padding: 80rpx 48rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.login-sub {
  color: #999;
  margin-bottom: 48rpx;
}

.input {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.login-btn { margin-top: 24rpx; }

.page { padding: 24rpx; }

.header-card {
  background: linear-gradient(135deg, #FF6B35, #FF8F65);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.rider-name { font-size: 36rpx; font-weight: 700; }
.rider-phone { opacity: 0.85; margin-top: 8rpx; font-size: 26rpx; }

.stats {
  display: flex;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.25);
}

.stat { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 32rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; opacity: 0.85; }

.active-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255,107,53,0.15);
  border: 2rpx solid #FF6B35;
  position: relative;
}

.active-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: #FF6B35;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 0 18rpx 0 18rpx;
}

.active-title { font-weight: 700; font-size: 30rpx; }
.active-status { color: #FF6B35; margin: 8rpx 0; }
.active-addr { color: #666; font-size: 26rpx; }
.active-btn { color: #FF6B35; margin-top: 16rpx; font-weight: 600; }

.empty-active {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.empty-text { color: #999; margin-bottom: 24rpx; }

.menu {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.menu-item:last-child { border-bottom: none; }
.arrow { color: #ccc; }
