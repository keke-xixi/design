.layout {
  display: flex;
  height: 100vh;
}

.sidebar {
  width: 180rpx;
  background: #f0f0f0;
  height: 100%;
}

.sidebar-item {
  padding: 32rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.sidebar-item.active {
  background: #fff;
  color: #FF6B35;
  font-weight: bold;
  border-left: 6rpx solid #FF6B35;
}

.content {
  flex: 1;
  padding: 16rpx;
  height: 100%;
}

.product-card {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.product-img {
  width: 140rpx;
  height: 140rpx;
  background: #FFF3EE;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.emoji { font-size: 56rpx; }

.product-info {
  flex: 1;
  margin-left: 16rpx;
}

.name { font-size: 28rpx; font-weight: bold; }
.sub { font-size: 22rpx; color: #999; margin: 6rpx 0; }

.bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.price { color: #FF6B35; font-weight: bold; }

.add-btn {
  width: 48rpx;
  height: 48rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  font-size: 32rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx;
}
