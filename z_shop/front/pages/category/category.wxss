.search-bar {
  display: flex;
  align-items: center;
  margin: 12rpx 16rpx;
  padding: 0 24rpx;
  height: 64rpx;
  background: #fff;
  border-radius: 32rpx;
}

.search-icon { font-size: 26rpx; margin-right: 10rpx; opacity: 0.45; }
.search-placeholder { font-size: 26rpx; color: #bbb; }

.layout {
  display: flex;
  height: calc(100vh - 88rpx);
  background: #f7f7f7;
}

.sidebar {
  width: 176rpx;
  background: #f0f0f0;
  height: 100%;
}

.sidebar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
  font-size: 24rpx;
  color: #666;
}

.sidebar-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.sidebar-name {
  text-align: center;
  line-height: 1.3;
}

.sidebar-item.active {
  background: #fff;
  color: #FF6B35;
  font-weight: 600;
  position: relative;
}

.sidebar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 48rpx;
  background: #FF6B35;
  border-radius: 0 6rpx 6rpx 0;
}

.content {
  flex: 1;
  padding: 16rpx;
  height: 100%;
}

.product-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.product-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.name { font-size: 28rpx; font-weight: 700; color: #222; }
.sub { font-size: 22rpx; color: #999; margin: 6rpx 0; }

.tags { display: flex; gap: 8rpx; margin-bottom: auto; }

.tag {
  font-size: 20rpx;
  color: #FF6B35;
  background: #FFF3EE;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.price-box { display: flex; align-items: baseline; gap: 8rpx; }
.price { color: #FF6B35; font-weight: 700; font-size: 30rpx; }
.original { color: #ccc; font-size: 22rpx; text-decoration: line-through; }

.add-btn {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8F65);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 52rpx;
  font-size: 32rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 107, 53, 0.3);
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx;
}
